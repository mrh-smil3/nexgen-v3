# Production origin, no trailing slash — canonical, hreflang, Open Graph and
# sitemap URLs are all built from it. Read at build time.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Cloudflare Turnstile (contact form bot check). The site key is read at build
# time; the secret is server-only.
CF_TURNSTILE_SITE_KEY=
CF_TURNSTILE_SECRET_KEY=

# Telegram bot that receives contact form leads.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
